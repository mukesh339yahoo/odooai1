<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_field_security_rule_form" model="ir.ui.view">
        <field name="name">field.security.rule.form</field>
        <field name="model">field.security.rule</field>
        <field name="arch" type="xml">
            <form string="Field &amp; UI Security Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Rule Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Hide Cost Price from Sales"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Target Configuration">
                            <field name="active" invisible="1"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="target_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="field_id" options="{'no_create': True}" 
                                   context="{'default_model_id': model_id}"
                                   invisible="target_type != 'field'"
                                   required="target_type == 'field'"/>
                            <field name="button_name" 
                                   invisible="target_type != 'button'"
                                   required="target_type == 'button'"/>
                            <field name="page_name" 
                                   invisible="target_type != 'page'"
                                   required="target_type == 'page'"/>
                            <field name="rule_type"/>
                            <field name="masking_pattern"
                                   invisible="rule_type != 'mask'"
                                   required="rule_type == 'mask'"/>
                            <field name="enforce_backend"
                                   invisible="rule_type not in ('readonly', 'invisible') or target_type != 'field'"/>
                        </group>
                        <group string="Scope &amp; Conditions">
                            <field name="sequence"/>
                            <field name="view_type"/>
                            <field name="domain" placeholder="e.g. state == 'done'"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="User &amp; Group Permissions">
                        <field name="apply_behavior" widget="radio" options="{'horizontal': True}"/>
                        <field name="group_ids" widget="many2many_tags" placeholder="User Groups to Include/Exclude..."/>
                        <field name="user_ids" widget="many2many_tags" placeholder="Specific Users to Include/Exclude..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_field_security_rule_tree" model="ir.ui.view">
        <field name="name">field.security.rule.list</field>
        <field name="model">field.security.rule</field>
        <field name="arch" type="xml">
            <list string="Field Security Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="target_type"/>
                <field name="field_id" optional="show"/>
                <field name="button_name" optional="hide"/>
                <field name="page_name" optional="hide"/>
                <field name="rule_type" 
                       decoration-danger="rule_type in ('invisible', 'no_export')"
                       decoration-warning="rule_type == 'readonly'"
                       decoration-info="rule_type == 'required'"
                       decoration-success="rule_type == 'mask'"/>
                <field name="enforce_backend" widget="boolean_toggle" optional="show"/>
                <field name="apply_behavior"/>
                <field name="view_type" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_field_security_rule_search" model="ir.ui.view">
        <field name="name">field.security.rule.search</field>
        <field name="model">field.security.rule</field>
        <field name="arch" type="xml">
            <search string="Search Rules">
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="button_name"/>
                <field name="page_name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Server Enforced" name="enforced" domain="[('enforce_backend', '=', True)]"/>
                <separator/>
                <filter string="Field Rules" name="fields_only" domain="[('target_type', '=', 'field')]"/>
                <filter string="Button Rules" name="buttons_only" domain="[('target_type', '=', 'button')]"/>
                <filter string="Tab / Page Rules" name="pages_only" domain="[('target_type', '=', 'page')]"/>
                <filter string="Masking Rules" name="masking_only" domain="[('rule_type', '=', 'mask')]"/>
                <separator/>
                <filter string="Group By Model" name="group_by_model" domain="[]" context="{'group_by': 'model_id'}"/>
                <filter string="Group By Target Type" name="group_by_target" domain="[]" context="{'group_by': 'target_type'}"/>
                <filter string="Group By Rule Type" name="group_by_rule_type" domain="[]" context="{'group_by': 'rule_type'}"/>
                <filter string="Group By Company" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_field_security_rule" model="ir.actions.act_window">
        <field name="name">UI &amp; Field Security Rules</field>
        <field name="res_model">field.security.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first UI &amp; Field Security Rule!
            </p>
            <p>
                Configure field-level security, hide action buttons or notebook tabs, mask confidential data, and enforce server-side write restrictions without any custom development.
            </p>
        </field>
    </record>

    <!-- Menu Item under Settings > Technical > Security -->
    <menuitem id="menu_field_security_rule"
              name="Field Security Rules"
              parent="base.menu_security"
              action="action_field_security_rule"
              sequence="100"/>

</odoo>
